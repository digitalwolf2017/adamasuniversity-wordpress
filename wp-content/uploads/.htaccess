# Disable execution of scripts in uploads directory
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|phps|pht|phar|pl|py|cgi|sh|bash)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
